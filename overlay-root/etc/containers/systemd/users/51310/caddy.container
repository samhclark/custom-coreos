[Unit]
Description=Caddy Reverse Proxy
Documentation=https://caddyserver.com/docs/

[Container]
ContainerName=caddy
Image=ghcr.io/samhclark/lab-caddy:2.11.4-cf-0.2.4@sha256:78331c4abc23f4f3f39675745af20b06d9aae97ae244772414e7933c8c1ab054
PodmanArgs=--runtime=krun
Annotation=krun.cpus=2
Annotation=krun.ram_mib=512
Annotation=krun.use_passt=1
StopSignal=SIGINT
Network=pasta:-T,3000,-T,3900,-T,3903,-T,8096,-T,8428
DNS=100.100.100.100
DNS=75.75.75.75
DNS=75.75.76.76
User=0

# Image-controlled configuration (read-only)
Volume=/usr/share/custom-coreos/caddy/Caddyfile:/etc/caddy/Caddyfile:ro

# Persistent certificate and ACME state; ownership and SELinux labels are prepared by the host unit
Volume=/var/lib/caddy:/data

# Persistent Caddy runtime configuration state; ownership and SELinux labels are prepared by the host unit
Volume=/var/lib/caddy-config:/config

# Runtime secret written at boot by sops-distribute-secrets.service
Volume=/run/nas-secrets/caddy/cf-api-token:/run/secrets/cf-api-token:ro,Z

PublishPort=0.0.0.0:80:80
PublishPort=0.0.0.0:443:443
PublishPort=0.0.0.0:443:443/udp
PublishPort=127.0.0.1:2019:2019

[Service]
ExecStartPre=/usr/bin/test -r /run/nas-secrets/caddy/cf-api-token
ExecStartPre=/usr/bin/bash -lc 'for i in {1..150}; do if /usr/bin/test -e /run/caddy-state/ready && /usr/bin/test -w /var/lib/caddy && /usr/bin/test -w /var/lib/caddy-config; then exit 0; fi; sleep 2; done; echo "Caddy state was not ready within 300 seconds" >&2; exit 1'
Restart=always
RestartSec=30
TimeoutStartSec=330

[Install]
WantedBy=default.target
