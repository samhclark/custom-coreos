AddHost=jellyfin-exporter.krun:10.253.8.2
AddHost=caddy.krun:10.253.9.2
AddHost=host.krun.internal:10.253.4.1

# Image-controlled alerting rules (read-only)
Volume=/usr/share/custom-coreos/vmalert:/etc/vmalert:ro

Exec=-datasource.url=http://victoria-metrics.krun:8428 -remoteWrite.url=http://victoria-metrics.krun:8428 -remoteRead.url=http://victoria-metrics.krun:8428 -notifier.url=http://alertmanager.krun:9093 -rule=/etc/vmalert/alert-rules.yml -httpListenAddr=0.0.0.0:8880

[Service]
ExecStartPre=/usr/bin/test -c /dev/net/tun
ExecStartPre=/usr/bin/test -e /sys/class/net/krun-51220
ExecStartPre=/usr/bin/bash -lc 'for i in {1..150}; do /usr/bin/curl -fsS http://127.0.0.1:8428/-/healthy >/dev/null 2>&1 && exit 0; sleep 2; done; echo "VictoriaMetrics did not become ready on 127.0.0.1:8428 within 300 seconds" >&2; exit 1'
Restart=always
RestartSec=30
TimeoutStartSec=330

[Install]
WantedBy=default.target
