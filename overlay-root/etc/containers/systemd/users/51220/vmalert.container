[Unit]
Description=VictoriaMetrics vmalert - Alerting Rules Evaluator
Documentation=https://docs.victoriametrics.com/vmalert/

[Container]
ContainerName=vmalert
Image=docker.io/victoriametrics/vmalert:v1.148.0@sha256:268ab5df69360a236e1382db0dbde44d5c32362b85501f761d61fc25c76f05ce
PodmanArgs=--runtime=krun
Annotation=krun.cpus=1
Annotation=krun.ram_mib=256
Annotation=krun.tap_name=krun-51220
StopSignal=SIGINT
Network=host
AddDevice=/dev/net/tun
AddHost=garage.krun:10.253.1.2
AddHost=jellyfin.krun:10.253.2.2
AddHost=grafana.krun:10.253.3.2
