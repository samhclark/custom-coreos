# GENERATED by generate-quadlets.py from quadlets/jellyfin.toml — DO NOT EDIT
[Unit]
Description=Jellyfin Media Server
Documentation=https://jellyfin.org/docs/

[Container]
ContainerName=jellyfin
Image=docker.io/jellyfin/jellyfin:10.11.11@sha256:aefb67e6a7ff1debdd154a78a7bbb780fd0c873d8639210a7f6a2016ad2b35db
PodmanArgs=--runtime=krun
Annotation=krun.cpus=4
Annotation=krun.ram_mib=4096
StopSignal=SIGINT
User=0

Environment=JELLYFIN_PublishedServerUrl=https://jellyfin.i.samhclark.com

# Persistent configuration ZFS dataset; ownership and SELinux labels are prepared by the host unit
Volume=/var/lib/jellyfin/config:/config

# Persistent cache and transcoding ZFS dataset; ownership and SELinux labels are prepared by the host unit
Volume=/var/lib/jellyfin/cache:/cache

# Existing movies library; read-only access and SELinux labels are verified by the host unit
Volume=/var/zfs/tank/videos/movies:/media/movies:ro

# Existing TV library; read-only access and SELinux labels are verified by the host unit
Volume=/var/zfs/tank/videos/tv-shows:/media/tv-shows:ro

PublishPort=127.0.0.1:8096:8096

[Service]
ExecStartPre=/usr/bin/bash -lc 'for i in {1..1800}; do if /usr/bin/test -e /run/jellyfin-storage/ready && [[ "$(/usr/bin/findmnt -rn -o SOURCE -T /var/lib/jellyfin/config 2>/dev/null)" == "tank/jellyfin/config" ]] && [[ "$(/usr/bin/findmnt -rn -o SOURCE -T /var/lib/jellyfin/cache 2>/dev/null)" == "tank/jellyfin/cache" ]] && [[ "$(/usr/bin/findmnt -rn -o SOURCE -T /var/zfs/tank/videos 2>/dev/null)" == "tank/videos" ]] && [[ "$(/usr/bin/stat -c %%u:%%g /var/lib/jellyfin/config 2>/dev/null)" == "51120:51120" ]] && [[ "$(/usr/bin/stat -c %%u:%%g /var/lib/jellyfin/cache 2>/dev/null)" == "51120:51120" ]] && /usr/bin/test -w /var/lib/jellyfin/config && /usr/bin/test -w /var/lib/jellyfin/cache && /usr/bin/test -r /var/zfs/tank/videos/movies && /usr/bin/test -x /var/zfs/tank/videos/movies && /usr/bin/test -r /var/zfs/tank/videos/tv-shows && /usr/bin/test -x /var/zfs/tank/videos/tv-shows; then exit 0; fi; sleep 2; done; echo "Jellyfin storage was not ready within 3600 seconds" >&2; exit 1'
ExecStartPre=/usr/bin/bash -lc 'if /usr/bin/ss -H -ltn | /usr/bin/grep -Eq ":8096[[:space:]]"; then echo "Refusing to start while a process already listens on Jellyfin host port 8096" >&2; exit 1; fi'
Restart=always
RestartSec=30
TimeoutStartSec=3900

[Install]
WantedBy=default.target
