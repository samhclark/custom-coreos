[Unit]
Description=Jellyfin Media Server
Documentation=https://jellyfin.org/docs/

[Container]
ContainerName=jellyfin
Image=docker.io/jellyfin/jellyfin:10.11.11@sha256:aefb67e6a7ff1debdd154a78a7bbb780fd0c873d8639210a7f6a2016ad2b35db
PodmanArgs=--runtime=krun
Annotation=krun.cpus=4
Annotation=krun.ram_mib=4096
Annotation=krun.tap_name=krun-51120
StopSignal=SIGINT
Network=host
AddDevice=/dev/net/tun
AddHost=garage.krun:10.253.1.2
AddHost=jellyfin.krun:10.253.2.2
AddHost=grafana.krun:10.253.3.2
AddHost=vmalert.krun:10.253.4.2
AddHost=blackbox-exporter.krun:10.253.5.2
AddHost=alertmanager.krun:10.253.6.2
AddHost=victoria-metrics.krun:10.253.7.2
AddHost=jellyfin-exporter.krun:10.253.8.2
AddHost=caddy.krun:10.253.9.2
AddHost=host.krun.internal:10.253.2.1
User=0
HealthCmd=none

Environment=JELLYFIN_PublishedServerUrl=https://jellyfin.i.samhclark.com

# Persistent configuration ZFS dataset; ownership and SELinux labels are prepared by the host unit
Volume=/var/lib/jellyfin/config:/config

# Persistent cache and transcoding ZFS dataset; ownership and SELinux labels are prepared by the host unit
Volume=/var/lib/jellyfin/cache:/cache

# Existing movies library; read-only access and SELinux labels are verified by the host unit
Volume=/var/zfs/tank/videos/movies:/media/movies:ro

# Existing TV library; read-only access and SELinux labels are verified by the host unit
Volume=/var/zfs/tank/videos/tv-shows:/media/tv-shows:ro

[Service]
ExecStartPre=/usr/bin/test -c /dev/net/tun
ExecStartPre=/usr/bin/bash -ceu 'for i in {1..90}; do if /usr/bin/test -r /run/nas-krun-network/policy-ready && /usr/bin/test -e /sys/class/net/krun-51120; then exit 0; fi; sleep 1; done; echo "krun network policy was not ready within 90 seconds" >&2; exit 1'
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/jellyfin-storage/ready 3600 2 /var/lib/jellyfin/config=tank/jellyfin/config /var/lib/jellyfin/cache=tank/jellyfin/cache /var/zfs/tank/videos=tank/videos
ExecStartPre=/usr/local/bin/nas-assert-tcp-ports-free.sh 8096
ExecStartPost=/usr/bin/bash -ceu 'for i in {1..30}; do if /usr/bin/timeout 1 /usr/bin/bash -c "</dev/tcp/10.253.2.2/8096" >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo "libkrun guest 10.253.2.2:8096 was not reachable" >&2; exit 1'
Restart=always
RestartSec=30
TimeoutStartSec=3900

[Install]
WantedBy=default.target
