[Unit]
Description=Prepare ZFS storage and media access for Jellyfin
Documentation=https://jellyfin.org/docs/general/installation/container/
Requires=zfs.target
Requires=ensure-nas-jellyfin-account.service
After=zfs.target ensure-nas-jellyfin-account.service
ConditionPathIsDirectory=/sys/module/zfs

[Service]
Type=oneshot
User=root
RuntimeDirectory=jellyfin-storage
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/rm -f /run/jellyfin-storage/ready
ExecStart=/usr/local/bin/zfs-prepare-jellyfin-storage.sh
ExecStartPost=/usr/bin/touch /run/jellyfin-storage/ready
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
