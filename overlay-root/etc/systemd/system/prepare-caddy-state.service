[Unit]
Description=Prepare persistent state for rootless Caddy
Requires=ensure-nas-caddy-account.service
After=local-fs.target ensure-nas-caddy-account.service

[Service]
Type=oneshot
User=root
RuntimeDirectory=caddy-state
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/rm -f /run/caddy-state/ready
ExecStart=/usr/local/bin/prepare-caddy-state.sh
ExecStartPost=/usr/bin/touch /run/caddy-state/ready
TimeoutStartSec=300
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
